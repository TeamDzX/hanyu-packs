      {
        "id": "pack_bug_story_firefly",
        "title": "夏夜的萤火虫",
        "titlePinyin": "xià yè de yínghuǒchóng",
        "titleEnglish": "Fireflies on a Summer Night",
        "level": 1,
        "theme": "<i class=\"fas fa-star\" style=\"color:#facc15\"></i>",
        "image": "https://raw.githubusercontent.com/TeamDzX/hanyu-packs/main/images/pack_bug_story_firefly.jpg",
        "sentences": [
          {
            "chinese": "夏天的晚上，我和妹妹去田边玩。",
            "pinyin": "Xiàtiān de wǎnshang, wǒ hé mèimei qù tián biān wán.",
            "english": "On a summer evening, my little sister and I go to play by the fields.",
            "words": [
              {
                "hanzi": "夏天",
                "pinyin": "xiàtiān",
                "english": "summer"
              },
              {
                "hanzi": "晚上",
                "pinyin": "wǎnshang",
                "english": "evening"
              },
              {
                "hanzi": "田边",
                "pinyin": "tián biān",
                "english": "edge of the fields"
              }
            ]
          },
          {
            "chinese": "草丛里有很多小小的光。",
            "pinyin": "Cǎocóng lǐ yǒu hěn duō xiǎoxiǎo de guāng.",
            "english": "There are lots of tiny lights in the grass.",
            "words": [
              {
                "hanzi": "草丛",
                "pinyin": "cǎocóng",
                "english": "clump of grass"
              },
              {
                "hanzi": "光",
                "pinyin": "guāng",
                "english": "light"
              }
            ]
          },
          {
            "chinese": "那是萤火虫！",
            "pinyin": "Nà shì yínghuǒchóng!",
            "english": "They are fireflies!",
            "words": [
              {
                "hanzi": "萤火虫",
                "pinyin": "yínghuǒchóng",
                "english": "firefly"
              }
            ]
          },
          {
            "chinese": "它们飞起来的时候，像天上的星星。",
            "pinyin": "Tāmen fēi qǐlái de shíhou, xiàng tiānshàng de xīngxing.",
            "english": "When they fly up, they look like stars in the sky.",
            "words": [
              {
                "hanzi": "飞",
                "pinyin": "fēi",
                "english": "to fly"
              },
              {
                "hanzi": "像",
                "pinyin": "xiàng",
                "english": "to look like"
              },
              {
                "hanzi": "星星",
                "pinyin": "xīngxing",
                "english": "star"
              }
            ]
          },
          {
            "chinese": "我们看了很久，没有抓它们。",
            "pinyin": "Wǒmen kàn le hěn jiǔ, méiyǒu zhuā tāmen.",
            "english": "We watched for a long time, and did not catch them.",
            "words": [
              {
                "hanzi": "很久",
                "pinyin": "hěn jiǔ",
                "english": "a long time"
              },
